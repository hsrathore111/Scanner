# Copy to .env (local dev) and also add these as EAS environment variables
# (expo.dev > project > Environment variables) for cloud builds.

# Firebase console > Project settings > Your apps > Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat > Project > API keys (public SDK keys, one per platform)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Legal / support (required by App Store review). Hosted from site/ on Firebase Hosting:
# https://YOUR_PROJECT.web.app/privacy and /terms
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
