rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Scan counters and appraisals are written only by Cloud Functions, so a client
    // can't reset its free scans, forge an appraisal or unlock a report without paying.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /items/{itemId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // Everything else, including appraisalJobs, is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
